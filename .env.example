# Copy this file to .env and fill in real values.

# Base URL the QR codes and Wallet "back to portal" link should point at.
# Switch this to your real university domain when you deploy.
PORTAL_BASE_URL=http://127.0.0.1:5000

# Flask session secret - set to a long random string in production.
SECRET_KEY=change-me-to-a-random-string

# Where Staff_Digital_ID.xlsx and generated QR codes are stored.
DATA_ROOT=C:\MDX-Digital-ID\Test

# --- Google Wallet (Generic Pass) ---
# From the Google Pay & Wallet Console (https://pay.google.com/business/console):
# Leave these blank to run the portal without Wallet - the "Add to Google Wallet"
# button will show a "not configured" state instead of erroring.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLASS_SUFFIX=mdx_staff_digital_id
# Path to the service account JSON key downloaded from Google Cloud Console.
GOOGLE_WALLET_SERVICE_ACCOUNT_FILE=
# Optional: publicly reachable HTTPS image URLs (localhost paths will NOT work
# inside the actual Wallet app, since Google fetches these server-side).
GOOGLE_WALLET_LOGO_URL=
GOOGLE_WALLET_HERO_IMAGE_URL=

# --- Apple Wallet (PassKit Generic Pass) ---
# From the Apple Developer portal (developer.apple.com/account/resources/identifiers):
# a Pass Type ID, its signing certificate + private key (exported as PEM), and
# Apple's WWDR intermediate certificate. Leave blank to run without Apple
# Wallet -- the "Add to Apple Wallet" button will show a "not configured"
# state instead of erroring.
APPLE_TEAM_IDENTIFIER=
APPLE_PASS_TYPE_IDENTIFIER=
APPLE_PASS_CERTIFICATE_FILE=
APPLE_PASS_KEY_FILE=
APPLE_PASS_KEY_PASSWORD=
APPLE_WWDR_CERTIFICATE_FILE=

# --- Admin portal login (/admin) ---
# A single shared administrator account for Microsoft SSO configuration and
# Staff Digital ID management. Leave blank to disable /admin entirely.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Microsoft Entra ID (Azure AD) SSO ---
# These are optional defaults -- an admin can also set/override them from
# /admin/sso, where the Client Secret is stored encrypted. Only needed here
# if you'd rather configure SSO via environment variables instead.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://127.0.0.1:5000/api/auth/azure/callback
